<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet
        id="20260913190000-1"
        author="cijhipster">

        <insert tableName="jhi_authority">
            <column
                name="name"
                value="ROLE_MANAGER"/>
        </insert>

    </changeSet>

    <changeSet
        id="20260913190000-2"
        author="cijhipster">

        <createTable tableName="manager_assignment">

            <column name="id" type="bigint">
                <constraints
                    primaryKey="true"
                    nullable="false"/>
            </column>

            <column
                name="manager_id"
                type="bigint">
                <constraints nullable="false"/>
            </column>

            <column
                name="client_user_id"
                type="bigint">
                <constraints nullable="false"/>
            </column>

            <column
                name="active"
                type="boolean"
                defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>

            <column
                name="created_at"
                type="timestamp with time zone"
                defaultValueComputed="${now}">
                <constraints nullable="false"/>
            </column>

        </createTable>

        <addForeignKeyConstraint
            constraintName="fk_manager_assignment_manager"
            baseTableName="manager_assignment"
            baseColumnNames="manager_id"
            referencedTableName="jhi_user"
            referencedColumnNames="id"/>

        <addForeignKeyConstraint
            constraintName="fk_manager_assignment_client"
            baseTableName="manager_assignment"
            baseColumnNames="client_user_id"
            referencedTableName="jhi_user"
            referencedColumnNames="id"/>

        <addUniqueConstraint
            tableName="manager_assignment"
            columnNames="manager_id, client_user_id"
            constraintName="ux_manager_assignment_manager_client"/>

        <createIndex
            tableName="manager_assignment"
            indexName="idx_manager_assignment_manager">
            <column name="manager_id"/>
        </createIndex>

        <createIndex
            tableName="manager_assignment"
            indexName="idx_manager_assignment_client">
            <column name="client_user_id"/>
        </createIndex>

        <createIndex
            tableName="manager_assignment"
            indexName="idx_manager_assignment_active">
            <column name="active"/>
        </createIndex>

        <sql>
            ALTER TABLE manager_assignment
            ADD CONSTRAINT chk_manager_assignment_not_self
            CHECK (manager_id &lt;&gt; client_user_id);
        </sql>

    </changeSet>

    <changeSet
        id="20260913190000-3"
        author="cijhipster">

        <createTable tableName="manager_permission">

            <column name="id" type="bigint">
                <constraints
                    primaryKey="true"
                    nullable="false"/>
            </column>

            <column
                name="assignment_id"
                type="bigint">
                <constraints nullable="false"/>
            </column>

            <column
                name="permission"
                type="varchar(50)">
                <constraints nullable="false"/>
            </column>

        </createTable>

        <addForeignKeyConstraint
            constraintName="fk_manager_permission_assignment"
            baseTableName="manager_permission"
            baseColumnNames="assignment_id"
            referencedTableName="manager_assignment"
            referencedColumnNames="id"
            onDelete="CASCADE"/>

        <addUniqueConstraint
            tableName="manager_permission"
            columnNames="assignment_id, permission"
            constraintName="ux_manager_permission_assignment_type"/>

        <createIndex
            tableName="manager_permission"
            indexName="idx_manager_permission_assignment">
            <column name="assignment_id"/>
        </createIndex>

        <createIndex
            tableName="manager_permission"
            indexName="idx_manager_permission_type">
            <column name="permission"/>
        </createIndex>

    </changeSet>

</databaseChangeLog>